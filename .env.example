# Pneumonia Detection — deployment environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env or real credentials to version control.

# ---------------------------------------------------------------------------
# Hugging Face — hosted model layer (required for hosted inference)
# ---------------------------------------------------------------------------

# Hugging Face model ID for the binary Normal-vs-Pneumonia classifier.
# Use a model repo you own or have access to, e.g. "username/pneumonia-binary".
HF_BINARY_MODEL_ID=

# Hugging Face model ID for the subtype Bacterial-vs-Viral classifier.
# Use a model repo you own or have access to, e.g. "username/pneumonia-subtype".
HF_SUBTYPE_MODEL_ID=

# Hugging Face access token (write-enabled for model repositories; read-only
# is sufficient for inference if the models are public).
HF_TOKEN=

# Hugging Face Inference API base URL. Change this if you use Inference
# Endpoints or a different deployment of the Inference API.
HF_API_BASE_URL=https://api-inference.huggingface.co/models

# ---------------------------------------------------------------------------
# Prediction thresholds (optional, defaults used if unset)
# ---------------------------------------------------------------------------

# Threshold for the Normal-vs-Pneumonia decision. Values above this are
# classified as Pneumonia.
PNEUMONIA_THRESHOLD=0.5

# Threshold for the Bacterial-vs-Viral subtype decision.
SUBTYPE_THRESHOLD=0.5

# Request timeout in seconds for Hugging Face Inference API calls.
HF_REQUEST_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Backend service settings (optional)
# ---------------------------------------------------------------------------

# Maximum accepted upload size in MB.
UPLOAD_MAX_SIZE_MB=10

# Comma-separated list of allowed CORS origins. When unset, all origins are
# allowed (convenient for local development, restrictive for production).
# Example: https://pneumonia-detection-8fz.pages.dev
ALLOWED_ORIGINS=

# Optional explainability (Grad-CAM) — local model path
# ----------------------------------------------------------------------------
# The production image intentionally does not install NumPy/PyTorch. To enable
# the local Grad-CAM path, build a separate image with the optional requirements
# and mount a checkpoint read-only:
#
#   INSTALL_EXPLAINABILITY=true docker compose build
#   INSTALL_EXPLAINABILITY=true LOCAL_MODEL_VOLUME=/absolute/path/to/models \
#   LOCAL_MODEL_PATH=/models/checkpoint.pt docker compose up
#
# The supported CPU path uses the separate optional requirements file and its
# lock metadata. For CUDA, select a matching PyTorch backend explicitly rather
# than adding a CUDA-local version suffix to a requirements file.
# LOCAL_MODEL_PATH=/models/checkpoint.pt
# LOCAL_MODEL_NAME=resnet
# LOCAL_MODEL_VOLUME=./models
